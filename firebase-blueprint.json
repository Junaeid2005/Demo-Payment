{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing authentication details, contact info, and default role",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin privilege record in the admins collection",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Gourmet dish or beverage offered by the restaurant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1024 },
        "price": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "isAvailable": { "type": "boolean" },
        "isPopular": { "type": "boolean" },
        "dietary": { "type": "array" },
        "prepTime": { "type": "string", "maxLength": 32 },
        "calories": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "description", "price", "category", "imageUrl", "isAvailable"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food order with item breakdown, pricing, and fulfillment status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "deliveryAddress": { "type": "string", "maxLength": 512 },
        "specialInstructions": { "type": "string", "maxLength": 1024 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "preparing", "ready", "delivered", "cancelled"]
        },
        "paymentMethod": { "type": "string", "enum": ["stripe", "cash"] },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending"] },
        "paymentIntentId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "userId", "customerName", "customerEmail", "customerPhone", "deliveryAddress", "items", "subtotal", "total", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Menu category classification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "slug": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 256 },
        "displayOrder": { "type": "number" }
      },
      "required": ["name", "slug"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile with contact info and role"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin registry for RBAC verification"
    },
    "/menuItems/{menuItemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Restaurant menu items with pricing and categorization"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer food orders with items and delivery tracking"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Food menu categories"
    }
  }
}
