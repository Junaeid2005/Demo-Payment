# Firebase configuration is loaded dynamically from firebase-applet-config.json

# Stripe Live or Test Keys (Collect from your Stripe Dashboard > Developers > API Keys)
# Publishable key (starts with pk_live_ or pk_test_) used in frontend
VITE_STRIPE_PUBLISHABLE_KEY=

# Secret key (starts with sk_live_ or sk_test_) used securely on server only
STRIPE_SECRET_KEY=

# Optional Gemini API key
GEMINI_API_KEY=
